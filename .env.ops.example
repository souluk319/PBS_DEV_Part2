# Copy to .env.ops for local overrides.

# Frontend wiring
VITE_OPS_API_BASE_URL=http://127.0.0.1:8000
VITE_PROXY_TARGET=http://backend:8765

# RAG runtime
# Ops keeps its legacy CLLM_* names for compatibility, but the runtime now also accepts
# PBS canonical aliases LLM_ENDPOINT / LLM_MODEL / LLM_API_KEY when they point to the same service.
CLLM_BASE_URL=http://cllm.example.local/v1
CLLM_MODEL=Qwen/Qwen3.5-9B
CLLM_API_KEY=
RAG_SOURCE_DIR=/app/data/corpus/pdfs
RAG_CACHE_DIR=/app/data/cache
RAG_EXTRACT_DIR=/app/data/extracted_markdown
SAVE_EXTRACTED_MARKDOWN=true
SAVE_EXTRACTED_HTML=true
SAVE_EXTRACTED_METADATA=true

# Embedding backend
# TEI keeps its legacy TEI_* names for compatibility, but the runtime now also accepts
# PBS canonical aliases EMBEDDING_BASE_URL / EMBEDDING_MODEL when they point to the same remote TEI service.
EMBEDDING_BACKEND=ollama
TEI_BASE_URL=
TEI_EMBEDDING_MODEL=bge-m3
TEI_TIMEOUT=120
EMBEDDING_BATCH_SIZE=32
EMBEDDING_PARALLEL_WORKERS=2
EMBEDDING_BATCH_CHAR_LIMIT=24000
STARTUP_AUTO_INDEX_ENABLED=false
PGVECTOR_PREFILTER_LIMIT=0

# Optional OpenAI guide generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# OCP live connection
OCP_API_BASE_URL=https://api.cluster.example.com:6443
OCP_API_TOKEN=
OCP_API_VERIFY_SSL=true
OCP_DEFAULT_NAMESPACE=default

# Chunking and answer behavior
RAG_STRUCTURED_CHUNK_SIZE=1000
RAG_STRUCTURED_CHUNK_OVERLAP=160
RAG_STRUCTURED_CHUNK_MIN_CHARS=300
USE_RESPONSE_CACHE=false
FORCE_KOREAN_ANSWERS=true
USE_QUERY_ROUTER=false

# Action and SCM secrets
RAG_TASK_SECRET_BACKEND=env_key
RAG_TASK_SECRET_MASTER_KEY=change-me-long-random-string
SCM_GITHUB_CLIENT_ID=
SCM_GITHUB_CLIENT_SECRET=
SCM_GITLAB_CLIENT_ID=
SCM_GITLAB_CLIENT_SECRET=
