# Copy to .env.pbs for local overrides.

# Play Book Studio runtime
ARTIFACTS_DIR=artifacts
SOURCE_MANIFEST_PATH=manifests/ocp_ko_4_20_approved_ko.json

# Embeddings
EMBEDDING_BASE_URL=http://tei.example.local/v1
EMBEDDING_MODEL=dragonkue/bge-m3-ko
EMBEDDING_DEVICE=auto
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=8

# Graph
GRAPH_ENABLED=true
GRAPH_BACKEND=neo4j
GRAPH_URI=bolt://host.docker.internal:7687
GRAPH_USERNAME=neo4j
GRAPH_PASSWORD=change-me
GRAPH_DATABASE=neo4j
GRAPH_BOOST_TOP_N=8
GRAPH_MAX_EDGE_FANOUT=12

# LLM
# PBS canonical names for the shared Qwen endpoint.
LLM_ENDPOINT=http://cllm.example.local/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3.5-9B

# Reranker
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_TOP_N=12
RERANKER_BATCH_SIZE=8
RERANKER_DEVICE=auto

# Optional OCR bridge
SURYA_OCR=
SURYA_HEALTH=
SURYA_TIMEOUT_SECONDS=30
